    "blocks": [
      {
        "type": "text",
        "text": "$\\dfrac1{2-\\sqrt3}=a+b$，其中 $a$ 為整數，$0<b<1$，則 $2a^2-4ab+2b^2=$ ？"
      }
    ],
    "verified": true,
