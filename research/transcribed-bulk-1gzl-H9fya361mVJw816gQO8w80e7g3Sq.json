    "sourceNumber": "一、3",
    "parentNumber": 3,
    "subnumber": null,
    "blocks": [
      {
        "type": "text",
        "text": "若 $\\sqrt{45}+\\sqrt{20}=\\sqrt a$，則 $a=$ ＿＿。"
      }
    ],
    "sourceSha256": "a8473f0251e61aefd0535cc17caa1367422be91a78c9b17473467d99c03f0367",
