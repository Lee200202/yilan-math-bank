    "verified": true
  },
  {
    "id": "zh-bulk-1gzl-H9fya361mVJw816gQO8w80e7g3Sq-fill-9",
    "sourceId": "zh-bulk-1gzl-H9fya361mVJw816gQO8w80e7g3Sq-fill-9",
    "sourceNumber": "一、9",
    "parentNumber": 9,
    "subnumber": null,
    "blocks": [
      {
        "type": "text",
        "text": "阿翰和黑人兩人在相同位置，若阿翰向西走 $3$ 單位，再向北走 $2$ 單位，黑人向東走 $4$ 單位，再向南走 $3$ 單位，則此時兩人距離為＿＿。"
      }
    ],
    "sourceSha256": "a8473f0251e61aefd0535cc17caa1367422be91a78c9b17473467d99c03f0367",
    "verified": true
  },
  {
