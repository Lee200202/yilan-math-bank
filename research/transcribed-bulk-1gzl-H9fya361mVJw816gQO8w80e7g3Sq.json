    "sourceId": "zh-bulk-1gzl-H9fya361mVJw816gQO8w80e7g3Sq-fill-6",
    "sourceNumber": "一、6",
    "parentNumber": 6,
    "subnumber": null,
    "blocks": [
      {
        "type": "text",
        "text": "已知坐標平面上 $C(-1,1)$、$D(7,-9)$ 兩點，求 $\\overline{CD}=$ ＿＿。"
      }
    ],
    "sourceSha256": "a8473f0251e61aefd0535cc17caa1367422be91a78c9b17473467d99c03f0367",
    "verified": true
  },
  {
