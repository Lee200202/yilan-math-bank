    "parentNumber": 2,
    "subnumber": null,
    "blocks": [
      {
        "type": "text",
        "text": "如圖，$\\overline{AE}=5\\sqrt2$，$\\overline{AB}=4\\sqrt3$，$\\overline{BC}=\\overline{DE}=4$，$\\overline{EF}=5$，試計算 $\\overline{CD}$ 長度？"
      },
