    "parentNumber": 3,
    "subnumber": null,
    "blocks": [
      {
        "type": "text",
        "text": "$3\\sqrt2$ 的小數部分為 $a$，求 $a^2+\\dfrac2a=$ ？"
      }
    ],
    "sourceSha256": "a8473f0251e61aefd0535cc17caa1367422be91a78c9b17473467d99c03f0367",
    "verified": true
  },
  {
    "id": "zh-bulk-1gzl-H9fya361mVJw816gQO8w80e7g3Sq-written-4",
    "sourceId": "zh-bulk-1gzl-H9fya361mVJw816gQO8w80e7g3Sq-written-4",
    "sourceNumber": "三、4",
    "parentNumber": 4,
    "subnumber": null,
    "blocks": [
      {
        "type": "text",
        "text": "已知 $a$、$b$ 皆不為 $0$，當 $ab=x$ 時，$a^2b-2a-2ab+4=0$，求 $x=$ ？"
      }
    ],
    "sourceSha256": "a8473f0251e61aefd0535cc17caa1367422be91a78c9b17473467d99c03f0367",
    "verified": true
  },
