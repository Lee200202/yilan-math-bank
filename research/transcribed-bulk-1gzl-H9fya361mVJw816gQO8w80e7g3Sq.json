    "sourceId": "zh-bulk-1gzl-H9fya361mVJw816gQO8w80e7g3Sq-written-1",
    "sourceNumber": "三、1",
    "parentNumber": 1,
    "subnumber": null,
    "blocks": [
      {
        "type": "text",
        "text": "圖中為一長方體盒子，$\\overline{AB}=4$，$\\overline{BF}=4$，$\\overline{FG}=12$，則＝？"
      },
