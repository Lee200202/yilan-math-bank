    "sourceId": "zh-bulk-1gzl-H9fya361mVJw816gQO8w80e7g3Sq-fill-7",
    "sourceNumber": "一、7",
    "parentNumber": 7,
    "subnumber": null,
    "blocks": [
      {
        "type": "text",
        "text": "已知 $4x^2+12x+b^2$ 為完全平方式，則 $b=$ ＿＿。"
      }
    ],
    "sourceSha256": "a8473f0251e61aefd0535cc17caa1367422be91a78c9b17473467d99c03f0367",
    "verified": true
  },
  {
