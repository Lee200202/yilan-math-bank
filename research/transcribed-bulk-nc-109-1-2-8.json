      {
        "type": "text",
        "text": "下列何者正確？"
      },
      {
        "type": "options",
        "items": [
          "$7<\\sqrt{15}<8$",
          "$7<\\sqrt{27}<8$",
          "$7<\\sqrt{48}<8$",
