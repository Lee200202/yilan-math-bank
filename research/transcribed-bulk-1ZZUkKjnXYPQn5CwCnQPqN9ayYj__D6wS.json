    "parentNumber": 8,
    "subnumber": null,
    "blocks": [
      {
        "type": "text",
        "text": "若 $A(16,14)$、$B(13,7)$ 為直角坐標平面上的兩點，則 $\\overline{AB}=$ ＿＿。"
      }
    ],
    "sourceSha256": "7c235ce425ee5e2978fd777495b922dae7345412c23e0d70ca4ee14073219459",
