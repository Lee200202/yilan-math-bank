    "parentNumber": 10,
    "subnumber": null,
    "blocks": [
      {
        "type": "text",
        "text": "已知 $P$、$Q$ 兩個多項式，其中 $P=(x+5)(2x-3)$、$Q=(5x+1)(3-2x)$，則下列選項何者是 $P$ 和 $Q$ 的公因式？答：＿＿。"
      },
      {
        "type": "options",
        "items": [
          "$x+5$",
          "$2x-3$",
          "$3-x$",
          "$6x+6$"
        ]
      }
    ],
    "sourceSha256": "7c235ce425ee5e2978fd777495b922dae7345412c23e0d70ca4ee14073219459",
    "verified": true,
