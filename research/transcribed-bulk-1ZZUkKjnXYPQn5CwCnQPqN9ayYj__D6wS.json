  },
  {
    "id": "zh-bulk-1ZZUkKjnXYPQn5CwCnQPqN9ayYj__D6wS-fill-20",
    "sourceId": "zh-bulk-1ZZUkKjnXYPQn5CwCnQPqN9ayYj__D6wS-fill-20",
    "sourceNumber": "一、20",
    "parentNumber": 20,
    "subnumber": null,
    "blocks": [
      {
        "type": "text",
        "text": "設 $x-1$ 及 $3x-2$ 都是 $6x^3+ax^2-x+b$ 的因式，則 $a+5b=$ ＿＿。"
      }
    ],
    "sourceSha256": "7c235ce425ee5e2978fd777495b922dae7345412c23e0d70ca4ee14073219459",
    "verified": true,
