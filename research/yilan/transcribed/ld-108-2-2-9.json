    {
      "type": "choice",
      "sourceNumber": "24",
      "page": 2,
      "difficulty": "hard",
      "primaryUnitId": "nanyi-9-2-2-2",
      "unitIds": [
        "nanyi-9-2-2-2"
      ],
      "unitAssignmentBasis": "古典機率與等可能事件。",
      "blocks": [
        {
          "type": "text",
          "text": "甲、乙、丙三個箱子原本各裝有相同數量的球，已知甲箱內的紅球占甲箱內球數的 $\\dfrac14$，乙箱內沒有紅球，丙箱內的紅球占丙箱內球數的 $\\dfrac7{12}$。小青將乙、丙兩箱內的球全倒入甲箱後，要從甲箱內取出一球，若甲箱內每球被取出的機會相等，則小青取出的球是紅球的機率為多少？"
        },
        {
          "type": "options",
          "items": [
            "$\\dfrac56$",
            "$\\dfrac5{12}$",
            "$\\dfrac5{18}$",
            "$\\dfrac7{48}$"
          ]
        }
      ]
    },
    {
      "type": "choice",
      "sourceNumber": "25",
      "page": 2,
      "difficulty": "hard",
      "primaryUnitId": "nanyi-9-2-2-2",
      "unitIds": [
        "nanyi-9-2-2-2"
      ],
      "unitAssignmentBasis": "古典機率與等可能事件。",
      "blocks": [
        {
          "type": "text",
          "text": "小花在 $A$ 筒內放編號1、3、5的球各一顆，在 $B$ 筒內放編號2、4的球各一顆。今小花先從其中一筒取一球，以該球編號當成十位數字；再從另一筒取一球，以該球編號當成個位數字。若每種結果的機會均等，則下列敘述何者錯誤？"
        },
        {
          "type": "options",
          "items": [
            "共有6種可能結果",
            "小花排出偶數的機率為 $\\dfrac12$",
            "小花排出3的倍數的機率為 $\\dfrac13$",
            "小花排出4的倍數的機率為 $\\dfrac14$"
          ]
        }
      ]
