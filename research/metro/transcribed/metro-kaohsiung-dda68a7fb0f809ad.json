     "type": "svg",
     "maxHeight": 140,
     "svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 175 170\"><g stroke=\"#777\" stroke-width=\"0.9\" fill=\"none\" stroke-dasharray=\"2,3\"><rect x=\"30\" y=\"20\" width=\"125\" height=\"125\"/><line x1=\"30\" y1=\"20\" x2=\"155\" y2=\"145\"/></g><polygon points=\"30,20 155,53.5 63.5,145\" fill=\"none\" stroke=\"#111\" stroke-width=\"1.8\"/><line x1=\"155\" y1=\"53.5\" x2=\"63.5\" y2=\"145\" stroke=\"#111\" stroke-width=\"1.8\"/><g fill=\"#111\"><circle cx=\"30\" cy=\"20\" r=\"2\"/><circle cx=\"155\" cy=\"20\" r=\"2\"/><circle cx=\"30\" cy=\"145\" r=\"2\"/><circle cx=\"155\" cy=\"145\" r=\"2\"/><circle cx=\"155\" cy=\"53.5\" r=\"2\"/><circle cx=\"63.5\" cy=\"145\" r=\"2\"/><circle cx=\"109\" cy=\"99\" r=\"2\"/></g><g font-size=\"15\" fill=\"#111\" font-family=\"sans-serif\"><text x=\"14\" y=\"16\">A</text><text x=\"160\" y=\"18\">D</text><text x=\"160\" y=\"58\">S</text><text x=\"10\" y=\"160\">B</text><text x=\"58\" y=\"162\">T</text><text x=\"160\" y=\"152\">C</text><text x=\"112\" y=\"116\">M</text></g></svg>"
    },
