=\"340\" cy=\"38\" r=\"2.5\"/><circle cx=\"380\" cy=\"20\" r=\"2.5\"/></g><g fill=\"#aaa\" stroke=\"#aaa\"><circle cx=\"230\" cy=\"95\" r=\"24\"/><circle cx=\"250\" cy=\"60\" r=\"26\"/><circle cx=\"290\" cy=\"45\" r=\"24\"/><circle cx=\"320\" cy=\"70\" r=\"24\"/><circle cx=\"300\" cy=\"105\" r=\"26\"/><circle cx=\"265\" cy=\"110\" r=\"24\"/><circle cx=\"280\" cy=\"80\" r=\"35\"/></g><g font-size=\"13\" fill=\"#111\" font-family=\"serif\" text-anchor=\"end\"><text x=\"54\" y=\"205\">0</text><text x=\"54\" y=\"169\">20</text><text x=\"54\" y=\"133\">40</text><text x=\"54\" y=\"97\">60</text><text x=\"54\" y=\"61\">80</text><text x=\"54\" y=\"25\">100</text></g><g font-size=\"13\" fill=\"#111\" font-family=\"serif\" text-anchor=\"middle\"><text x=\"60\" y=\"217\">145</text><text x=\"100\" y=\"217\">150</text><text x=\"140\" y=\"217\">155</text><text x=\"180\" y=\"217\">160</text><text x=\"220\" y=\"217\">165</text><text x=\"260\" y=\"217\">170</text><text x=\"300\" y=\"217\">175</text><text x=\"340\" y=\"217\">180</text><text x=\"380\" y=\"217\">185</text><text x=\"94\" y=\"185\">5</text><text x=\"134\" y=\"167\">15</text><text x=\"174\" y=\"156\">20</text><text x=\"214\" y=\"122\">40</text><text x=\"332\" y=\"32\">90</text><text x=\"378\" y=\"14\">100</text><text x=\"330\" y=\"236\">身高（公分）</text></g><text x=\"4\" y=\"12\" font-size=\"13\" fill=\"#111\" font-family=\"serif\">累積相對次數（%）</text></svg>"
