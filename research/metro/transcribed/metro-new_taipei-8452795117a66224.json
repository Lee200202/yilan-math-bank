    {"type": "choice", "sourceNumber": "9", "page": 2, "difficulty": "easy", "primaryUnitId": "nanyi-7-2-4-1", "unitIds": ["nanyi-7-2-4-1"], "unitAssignmentBasis": "解比例式。",
