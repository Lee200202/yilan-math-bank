    {"type": "fill", "sourceNumber": "5", "page": 3, "difficulty": "easy", "primaryUnitId": "nanyi-7-2-4-2", "unitIds": ["nanyi-7-2-4-2"], "unitAssignmentBasis": "反比求值。",
     "blocks": [{"type": "text", "text": "若 $y$ 與 $x$ 成反比，且當 $x=4$ 時，$y=6$，則當 $x=8$ 時，$y=$＿＿＿＿。"}]},
