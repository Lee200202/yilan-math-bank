    {"type": "choice", "sourceNumber": "1", "page": 1, "difficulty": "easy", "primaryUnitId": "nanyi-7-2-4-1", "unitIds": ["nanyi-7-2-4-1"], "unitAssignmentBasis": "求比值。",
     "blocks": [{"type": "text", "text": "圖書館新進一批書，共有 $20$ 本，志工已經整理並上架了 $5$ 本。若以「尚未上架的本數」與「全部新書本數」相比，則其比值為多少？"}, {"type": "options", "items": ["$\\dfrac{1}{4}$", "$\\dfrac{1}{3}$", "$\\dfrac{2}{5}$", "$\\dfrac{3}{4}$"]}]},
