      "blocks": [
        {
          "type": "text",
          "text": "如圖為 $7$ 個正方形紙板緊密地拼成長方形 $ABCD$ 的方式。求 $\\overline{AB}:\\overline{AD}=$？"
        },
        {
          "type": "svg",
          "maxHeight": 100,
          "svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 260 150\"><g fill=\"none\" stroke=\"#111\" stroke-width=\"1.4\"><path d=\"M25 15 H215 V135 H25 Z M145 15 V135 M145 85 H215 M165 85 V135 M145 95 H165 M145 115 H165 M155 85 V95\"/></g><g fill=\"#111\" font-size=\"14\"><text x=\"12\" y=\"12\">A</text><text x=\"12\" y=\"148\">B</text><text x=\"216\" y=\"148\">C</text><text x=\"216\" y=\"12\">D</text></g></svg>"
