      ],
      "unitAssignmentBasis": "依題目主要概念歸屬。",
      "blocks": [
        {
          "type": "text",
          "text": "等差數列 $a_1,a_2,a_3,\\ldots,a_n$ 中，若 $a_{50}-a_{30}=8$，則 $a_{200}-a_{100}=$＿＿＿＿。"
        }
      ]
    },
    {
