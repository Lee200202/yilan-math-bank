      "unitAssignmentBasis": "依題目主要概念歸屬。",
      "blocks": [
        {
          "type": "text",
          "text": "在 $\\triangle ABC$ 中，已知 $\\angle A+\\angle B=125^\\circ$，$\\angle A+\\angle C=105^\\circ$，求 $\\triangle ABC$ 為何種三角形＿＿＿＿。（銳角、直角、鈍角）"
        }
      ]
    },
    {
      "type": "fill",
      "sourceNumber": "9",
      "page": 2,
      "difficulty": "hard",
      "primaryUnitId": "nanyi-8-2-3-1",
      "unitIds": [
