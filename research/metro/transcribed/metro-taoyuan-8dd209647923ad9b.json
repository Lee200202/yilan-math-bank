      ],
      "unitAssignmentBasis": "依題目主要概念歸屬。",
      "blocks": [
        {
          "type": "text",
          "text": "若等差級數共有 $15$ 項，其首項為 $44$，公差為 $-3$，求總和＝＿＿＿＿。"
        }
      ]
    },
    {
      "type": "fill",
      "sourceNumber": "7",
      "page": 2,
      "difficulty": "medium",
      "primaryUnitId": "nanyi-8-2-1-1",
