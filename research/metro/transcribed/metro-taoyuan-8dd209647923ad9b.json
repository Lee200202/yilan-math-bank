      ],
      "unitAssignmentBasis": "依題目主要概念歸屬。",
      "blocks": [
        {
          "type": "text",
          "text": "一等差級數前 $n$ 項的和為 $S_n$，若 $S_n=(3n-1)n$，則此等差級數的第 $10$ 項為多少？"
        },
        {
          "type": "options",
          "items": [
            "$56$",
            "$58$",
            "$60$",
            "$62$"
          ]
        }
      ]
    },
    {
      "type": "choice",
      "sourceNumber": "9",
      "page": 1,
      "difficulty": "medium",
      "primaryUnitId": "nanyi-8-2-3-3",
      "unitIds": [
