  {
   "type": "choice",
   "sourceNumber": "22",
   "page": 3,
   "difficulty": "hard",
   "primaryUnitId": "nanyi-9-2-1-1",
   "unitIds": [
    "nanyi-9-2-1-1"
   ],
   "unitAssignmentBasis": "比較四個拋物線頂點高度，找出恰有三個交點的水平線。",
   "blocks": [
    {
     "type": "text",
     "text": "直角坐標平面上繪有 $y=5(x-2)^{2}+3$、$y=(x+2)^{2}+5$、$y=-2(x-4)^{2}-7$、$y=-3(x+5)^{2}-3$ 四個二次函數的圖形，下列何者與其在直角坐標平面上的圖形會剛好有三個交點？"
    },
    {
     "type": "options",
