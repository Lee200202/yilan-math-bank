      "page": 2,
      "difficulty": "medium",
      "primaryUnitId": "nanyi-7-2-2-3",
      "unitIds": [
        "nanyi-7-2-2-3"
      ],
      "unitAssignmentBasis": "整體倍數關係求總價。",
      "blocks": [
        {
          "type": "text",
          "text": "蛋餅 $9$ 份和奶茶 $6$ 杯共要 $360$ 元，小和買蛋餅 $6$ 份和奶茶 $4$ 杯付了 $300$ 元，可找回多少元？"
        },
        {
          "type": "options",
          "items": [
            "$20$",
            "$40$",
            "$60$",
            "$80$"
          ]
        }
      ]
    },
