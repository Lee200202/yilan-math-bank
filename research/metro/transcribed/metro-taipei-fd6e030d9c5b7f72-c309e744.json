      "unitAssignmentBasis": "二元一次式化簡。",
      "blocks": [
        {
          "type": "text",
          "text": "化簡 $5(-x-8y)-3(2x-9y)=$＿＿＿＿。"
        }
      ]
    },
    {
      "type": "fill",
      "sourceNumber": "17",
      "page": 2,
      "difficulty": "medium",
      "primaryUnitId": "nanyi-7-2-2-1",
      "unitIds": [
