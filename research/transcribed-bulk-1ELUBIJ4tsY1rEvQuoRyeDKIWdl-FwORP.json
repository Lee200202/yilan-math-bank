    "subnumber": null,
    "blocks": [
      {
        "type": "text",
        "text": "利用配方法解 $3x^2+16x-21=0$ 得 $x=\\dfrac{-8\\pm\\sqrt m}{3}$，則 $m=$ ＿＿。"
      }
    ],
    "sourceSha256": "8079abb3dd887ef3c1ade862697b87f9d93326fc679a47db530a14d9c3d6d8ca",
    "verified": true
  },
  {
