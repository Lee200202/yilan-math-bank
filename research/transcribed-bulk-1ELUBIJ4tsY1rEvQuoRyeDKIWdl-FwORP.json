    "sourceNumber": "二、7",
    "parentNumber": 7,
    "subnumber": null,
    "blocks": [
      {
        "type": "text",
        "text": "小惠出生於民國 $72$ 年，經過了 $x$ 年，正好是民國 $x^2$ 年，則 $x=$ ＿＿。"
      }
    ],
    "sourceSha256": "8079abb3dd887ef3c1ade862697b87f9d93326fc679a47db530a14d9c3d6d8ca",
    "verified": true
  },
