    "sourceId": "zh-bulk-1ELUBIJ4tsY1rEvQuoRyeDKIWdl-FwORP-fill-advanced-4",
    "sourceNumber": "二、4",
    "parentNumber": 4,
    "subnumber": null,
    "blocks": [
      {
        "type": "text",
        "text": "若 $m$ 是 $(x+4)(2x-1)=-3$ 的一個解，則 $\\sqrt{2m^2+7m+15}=$ ＿＿。"
      }
    ],
    "sourceSha256": "8079abb3dd887ef3c1ade862697b87f9d93326fc679a47db530a14d9c3d6d8ca",
    "verified": true
