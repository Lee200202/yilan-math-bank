  {
    "id": "ld-112-1-2-8-fill-6",
    "blocks": [
      {
        "type": "text",
        "text": "$x^2-5x+6$ 可因式分解成 $(x+a)(x+b)$，則 $a+b=$＿＿＿＿。"
      }
    ],
    "verified": true,
    "sourceSha256": "7b7993d35c10493b1f05c2ff079fcd5faa496b304bb85336886c139fe24192b2"
  },
  {
