      {
        "type": "text",
        "text": "已知 $6x^2+5x-6=(3x-2)(2x+3)$，則下列哪個不是 $6x^2+5x-6$ 的因式？"
      },
      {
        "type": "options",
        "items": [
          "$-3x+2$",
          "$2x-3$",
          "$2x+3$",
          "$(3x-2)(2x+3)$"
        ]
      }
    ],
    "sourceSha256": "c2c18a429d66913df2021d04dfdd74ef40038740fde2918752a7a6e47c9d586b",
    "verified": true
